{
  "servers": {
    "csswiki": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp@latest", "Supportability"],
      "env": {
        "npm_config_registry": "https://packagefeedproxy.microsoft.io/npm/"
      }
    },
    "msdata": {
      "type": "stdio",
      "command": "npx",
